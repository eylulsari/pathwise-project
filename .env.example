# ─────────────────────────────────────────────────────────────
# Pathwise — Environment configuration example
# Copy to `.env` and adjust values. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# ── App ──
NODE_ENV=development

# ── Frontend (Vite) ──
# Base URL the browser uses to reach the backend API.
VITE_API_URL=http://localhost:3000/api

# ── Backend ──
BACKEND_PORT=3000
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173

# ── PostgreSQL ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pathwise
POSTGRES_PASSWORD=pathwise_dev_password
POSTGRES_DB=pathwise
# When true, TypeORM auto-creates schema (dev only, never in prod).
DB_SYNCHRONIZE=true

# ── Redis (JWT refresh tokens + cache) ──
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT ──
# Access token: short-lived (~15m). Refresh token: long-lived, stored in Redis.
JWT_ACCESS_SECRET=change_me_access_secret_in_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_in_production
JWT_REFRESH_TTL=7d

OPENWEATHER_API_KEY=your_openweathermap_api_key_here