# ─────────────────────────────────────────────────────────────
# Pathwise — Environment configuration example
# Copy to `.env` and adjust values. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# ── App ──
NODE_ENV=development

# ── Frontend (Vite) ──
# Base URL the browser uses to reach the backend API.
VITE_API_URL=http://localhost:3000/api

# ── Backend ──
BACKEND_PORT=3000
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173

# ── PostgreSQL ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pathwise
POSTGRES_PASSWORD=pathwise_dev_password
POSTGRES_DB=pathwise
# When true, TypeORM auto-creates schema (dev only, never in prod).
DB_SYNCHRONIZE=true

# ── Redis (JWT refresh tokens + cache) ──
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT ──
# Access token: short-lived (~15m). Refresh token: long-lived, stored in Redis.
JWT_ACCESS_SECRET=change_me_access_secret_in_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_in_production
JWT_REFRESH_TTL=7d

# ── Weather (OpenWeatherMap) ──
# Free tier key from https://openweathermap.org/api. Optional — the weather
# widget degrades to a static fallback when unset.
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── AI Assistant (Google Gemini) ──
# Free-tier key from Google AI Studio (https://aistudio.google.com/apikey) —
# no credit card required. Optional: when unset (or on any API error) the
# assistant falls back to canned answers, it never breaks the chat.
GEMINI_API_KEY=your_gemini_api_key_here
# Flash model used for chat. Override if a newer free-tier Flash ships.
GEMINI_MODEL=gemini-3.5-flash-lite