# ─────────────────────────────────────────────────────────────
# Pathwise — Environment configuration example
# Copy to `.env` and adjust values. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# ── App ──
NODE_ENV=development

# ── Frontend (Vite) ──
# Base URL the browser uses to reach the backend API.
VITE_API_URL=http://localhost:3000/api
# Where the "forgot password" note tells people to write. Optional — the app
# falls back to support@pathwise.app. Vite inlines it at BUILD time, so
# changing it means rebuilding the image, not restarting it.
VITE_SUPPORT_EMAIL=support@pathwise.app

# ── Backend ──
BACKEND_PORT=3000
# Comma-separated list of allowed CORS origins. Both spellings of the dev host
# are listed: a page opened on 127.0.0.1 sends a different Origin than one
# opened on localhost, and either is a normal way to reach the dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Requests/min allowed on the auth endpoints.
# ⚠️ This file is copied verbatim to `.env` for local dev AND by CI, so the
# value here is the DEV value. Tighten it to 10 in production — like
# DB_SYNCHRONIZE above, the setting that is convenient here is not the one you
# want live. Do not lower it here: the E2E suite registers a fresh account per
# spec across parallel workers and will throttle itself, which surfaces as
# every sign-up timing out rather than as an obvious 429.
AUTH_THROTTLE_LIMIT=100

# ── PostgreSQL ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pathwise
POSTGRES_PASSWORD=pathwise_dev_password
POSTGRES_DB=pathwise
# When true, TypeORM auto-creates schema (dev only, never in prod).
DB_SYNCHRONIZE=true

# ── JWT ──
# Access token: short-lived (~15m). Refresh token: long-lived; its JTI is
# stored in Postgres (`refresh_tokens`), so sessions survive a restart.
JWT_ACCESS_SECRET=change_me_access_secret_in_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_in_production
JWT_REFRESH_TTL=7d

# â”€â”€ Transactional email (Resend) â”€â”€
# Create an API key at https://resend.com/api-keys and use a verified sender.
# Password reset is disabled until BOTH values are configured. FROM_EMAIL may
# include a display name, for example: Pathwise <no-reply@example.com>.
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=Pathwise <no-reply@example.com>
# Public frontend URL used to build password reset links.
APP_URL=http://localhost:5173

# ── Weather (OpenWeatherMap) ──
# Free tier key from https://openweathermap.org/api. Optional — the weather
# widget degrades to a static fallback when unset.
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── AI Assistant ──
# Two providers are supported. The backend uses GROQ first and falls back to
# GEMINI; when neither key is set (or the call fails) the assistant returns
# canned answers — it never breaks the chat.
# THIS FILE IS COMMITTED: placeholders only, never paste a real key here.

# Groq (preferred). Free key from https://console.groq.com/keys — starts `gsk_`.
# OpenAI-compatible API.
GROQ_API_KEY=your_groq_api_key_here
# Small/fast free-tier model. See https://console.groq.com/docs/models — Groq
# deprecated the llama-3.x chat models on 2026-06-17.
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (secondary). Key from https://aistudio.google.com/apikey.
# NOTE: AI Studio now issues `AQ.`-prefixed auth keys and a subset of accounts
# get 401 ACCESS_TOKEN_TYPE_UNSUPPORTED on every endpoint — that rollout bug is
# why Groq is preferred.
GEMINI_API_KEY=your_gemini_api_key_here
# Flash model used for chat. Override if a newer free-tier Flash ships.
GEMINI_MODEL=gemini-3.5-flash-lite
